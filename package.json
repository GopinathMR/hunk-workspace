{
  "name": "hunk-workspace",
  "version": "0.1.0",
  "description": "Review every changed sub-repo of a multi-repo workspace in one Hunk session, with a Repos sidebar",
  "type": "module",
  "private": true,
  "hunk": {
    "extensions": ["./src/index.tsx"],
    "apiVersion": 31
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "hunkdiff": "0.24.0-beta.1",
    "typescript": "^5.6.0"
  }
}
