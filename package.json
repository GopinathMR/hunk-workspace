{
  "name": "hunk-workspace",
  "version": "0.1.0",
  "description": "Review every changed sub-repo of a multi-repo workspace in one Hunk session, with a Repos sidebar",
  "type": "module",
  "private": true,
  "hunk": {
    "extensions": ["./src/index.tsx"],
    "apiVersion": 31
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "hunkdiff": "0.24.0-beta.1",
    "react": "^19.2.4",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GopinathMR/hunk-workspace.git"
  },
  "keywords": [
    "hunk-extension",
    "hunk",
    "diff",
    "git",
    "workspace",
    "multi-repo"
  ],
  "license": "Apache-2.0"
}
